# FastAPI AI/ML Bridge Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
MODEL_PATH=saved_models/baseline_model.joblib
LOG_LEVEL=info

# --- Module 2: Legal, Document & Cost Guidance (document reader) ---
# macOS (Homebrew):  brew install tesseract poppler     -> usually found automatically
# Windows: install Tesseract (UB-Mannheim build) then uncomment and fix the path:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\Library\bin
# macOS only if Tesseract is not auto-detected:
# TESSERACT_CMD=/opt/homebrew/bin/tesseract

# Optional: let Claude fill document fields OCR missed.
# PRIVACY: when set, the uploaded document image is sent to the Anthropic API. Leave empty to stay fully local.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_UPLOAD_MB=8
