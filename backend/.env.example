# SafeMaga Express Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/safemaga_db

# JWT Secret & Expiration
JWT_SECRET=safemaga_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Python FastAPI AI/ML Bridge Service URL
AI_SERVICE_URL=http://127.0.0.1:8000

# Client Application URL for CORS
CORS_ORIGIN=http://localhost:3000

# --- Module 2: Legal, Document & Cost Guidance ---
# LKR per 1 USD, used by the cost estimator (update regularly)
USD_TO_LKR=300
# Only used by `npm run seed:guidance` when NODE_ENV=production (otherwise default dev accounts are created)
# SEED_ADMIN_PASSWORD=
